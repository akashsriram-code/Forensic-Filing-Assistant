{
  "manifest_version": 3,
  "name": "SCOUT Live",
  "version": "0.1.0",
  "description": "Desktop alerts the moment EDGAR publishes a filing from a company you follow in SCOUT.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SCOUT Live",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "notifications", "storage", "declarativeNetRequest", "scripting"],
  "host_permissions": ["https://www.sec.gov/*", "https://data.sec.gov/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
